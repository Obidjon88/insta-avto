# Bu faylni ".env" deb nusxalang va qiymatlarni to'ldiring.
# Meta Developers -> ilovangiz -> Instagram -> API setup with Instagram login -> Generate token
IG_ACCESS_TOKEN=bu_yerga_token
# Ixtiyoriy: "me" ham ishlaydi
IG_USER_ID=me
IG_API_VERSION=v23.0
# Ixtiyoriy: schedule.csv da faqat fayl nomini yozish uchun ochiq papka manzili
# Masalan GitHub public repo: https://raw.githubusercontent.com/LOGIN/insta-media/main
MEDIA_BASE_URL=
